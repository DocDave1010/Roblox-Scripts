-- Button Funktion
local function createToggle(name, y)

	local enabled = false

	local toggle = Instance.new("TextButton")

	toggle.Size = UDim2.new(0,180,0,30)
	toggle.Position = UDim2.new(0.5,-90,0,y)

	toggle.BackgroundColor3 = Color3.fromRGB(25,25,35)
	toggle.BorderSizePixel = 0

	toggle.Text = name .. " : OFF"
	toggle.TextColor3 = Color3.fromRGB(255,255,255)
	toggle.TextSize = 14
	toggle.Font = Enum.Font.Gotham

	toggle.Parent = main


	local stroke = Instance.new("UIStroke")
	stroke.Color = Color3.fromRGB(0,255,255)
	stroke.Thickness = 1
	stroke.Parent = toggle


	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0,5)
	corner.Parent = toggle


	toggle.MouseButton1Click:Connect(function()

        enabled = not enabled

        if name == "AUTOFARM" then
        
            running = enabled

            if running then
                print("AUTO START")
                task.spawn(StartLoop)
            else
                print("AUTO STOP")
            end
        
        end

        if name == "TOGGLE EVENT" then

        	runningMusic = enabled

        	if runningMusic then

        		print("Music aktiviert")
        		StartMusicLoop()

        	else

        		print("Music deaktiviert")

        	end

        end

        if enabled then
            toggle.Text = name .. " : ON"
            toggle.BackgroundColor3 = Color3.fromRGB(0,120,120)

        else
           toggle.Text = name .. " : OFF"
           toggle.BackgroundColor3 = Color3.fromRGB(25,25,35)

        end

    end)

end


-- Drei Buttons
createToggle("AUTOFARM",45)
